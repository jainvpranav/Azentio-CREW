# Copy to .env and fill in your own values. Never commit the real .env file.

# Optional. Without this, the AI Reviewer (Phase 6) falls back to a
# deterministic NEEDS_INFORMATION result instead of calling an LLM -
# see ASSUMPTIONS.md A-005 and app/ai/llm_client.py.
ANTHROPIC_API_KEY=

# Optional, defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional, defaults to sqlite:///./statements.db
DATABASE_URL=
